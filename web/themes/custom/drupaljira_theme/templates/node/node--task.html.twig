{#
/**
 * @file
 * Theme override for a task node.
 */
#}
<article{{ attributes.addClass('node', 'node--type-task', 'task-node-card') }}>
  {{ title_prefix }}
  {% if not page %}
    <h2{{ title_attributes.addClass('node__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  <div class="node__content">
    {{ content }}
  </div>
</article>
