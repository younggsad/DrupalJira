{{ jira_navigation_cache }}
{% set sidebar_first = page.sidebar_first|render %}
{% set sidebar_second = page.sidebar_second|render %}
<div class="drupaljira-layout">
  {% include '@drupaljira_theme/components/header.html.twig' %}

  {% if page.header %}
    <div class="drupaljira-header-region">
      <div class="drupaljira-header-region__container">
        {{ page.header }}
      </div>
    </div>
  {% endif %}

  <main id="main-content" class="drupaljira-main" tabindex="-1">
    <div class="drupaljira-main__container">
      {% if page.breadcrumb %}
        <div class="drupaljira-breadcrumb">{{ page.breadcrumb }}</div>
      {% endif %}

      {% if page.highlighted %}
        <div class="drupaljira-highlighted">{{ page.highlighted }}</div>
      {% endif %}

      {% if page.help %}
        <div class="drupaljira-help">{{ page.help }}</div>
      {% endif %}

      <div class="drupaljira-layout__inner">
        {% if sidebar_first|striptags|trim or jira_project_navigation %}
          <aside class="drupaljira-sidebar drupaljira-sidebar--first" role="complementary">
            {% if jira_project_navigation %}
              {% include '@drupaljira_theme/components/project-navigation.html.twig' %}
            {% endif %}
            {{ sidebar_first }}
          </aside>
        {% endif %}

        <div class="drupaljira-content-area">
          {% if jira_is_sprint %}
            <section class="drupaljira-sprint-stub">{{ page.content }}</section>
          {% else %}
            {{ page.content }}
          {% endif %}
        </div>

        {% if sidebar_second|striptags|trim %}
          <aside class="drupaljira-sidebar drupaljira-sidebar--second" role="complementary">
            {{ sidebar_second }}
          </aside>
        {% endif %}
      </div>
    </div>
  </main>

  {% if page.footer %}
    <footer class="drupaljira-footer" role="contentinfo">
      <div class="drupaljira-footer__container">
        {{ page.footer }}
      </div>
    </footer>
  {% endif %}
</div>
