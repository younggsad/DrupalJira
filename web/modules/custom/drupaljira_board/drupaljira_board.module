<?php

/**
 * @file
 * Primary module hooks for DrupalJira Board module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_theme().
 */
function drupaljira_board_theme(): array {
  return [
    'drupaljira_projects' => [
      'variables' => [
        'projects' => [],
        'tasks' => [],
        'authenticated' => FALSE,
        'create_project' => [],
        'sign_in' => [],
        'pager' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_entity_presave().
 */
function drupaljira_board_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'task') {
    return;
  }

  if (!$entity->hasField('moderation_state') || !$entity->hasField('field_status')) {
    return;
  }

  $moderation_state = $entity->get('moderation_state')->value;

  if ($moderation_state !== NULL) {
    $entity->set('field_status', $moderation_state);
  }
}

/**
 * Implements hook_node_view_alter().
 */
function drupaljira_board_node_view_alter(
  array &$build,
  NodeInterface $node,
  EntityViewDisplayInterface $display,
): void {
  if ($node->bundle() !== 'task') {
    return;
  }

  if ($display->getMode() === 'default') {
    $moderation_information = \Drupal::service(
      'content_moderation.moderation_information',
    );

    if ($moderation_information->isModeratedEntity($node)) {
      $workflow = $moderation_information->getWorkflowForEntity($node);

      if ($workflow) {
        $state_id = $node->get('moderation_state')->value;
        $state = $workflow->getTypePlugin()->getState($state_id);

        $build['moderation_state_display'] = [
          '#type' => 'item',
          '#title' => t('Status'),
          '#plain_text' => $state->label(),
        ];
      }
    }

    return;
  }

  if ($display->getMode() !== 'teaser') {
    return;
  }

  $build['#cache']['contexts'][] = 'user';

  $current_user_id = (int) \Drupal::currentUser()->id();

  if ($current_user_id === 0) {
    return;
  }

  if ($node->get('field_assignee')->isEmpty()) {
    return;
  }

  $assignee_id = (int) $node->get('field_assignee')->target_id;

  if ($assignee_id !== $current_user_id) {
    return;
  }

  $build['#attributes']['class'][] = 'my-task';
}

/**
 * Implements hook_form_node_task_form_alter().
 *
 * Normal creation saves the workflow default instead of the first available
 * outgoing transition selected by the moderation widget.
 */
function drupaljira_board_form_node_task_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  drupaljira_board_preserve_task_state($form);
}

/**
 * Implements hook_form_node_task_edit_form_alter().
 */
function drupaljira_board_form_node_task_edit_form_alter(
  array &$form,
  FormStateInterface $form_state,
): void {
  drupaljira_board_preserve_task_state($form);
}

/**
 * Adds normal Save alongside the original Content Moderation submit action.
 */
function drupaljira_board_preserve_task_state(array &$form): void {
  // Process after all form alters, including Content Moderation's redirect
  // handler, but before children are processed and submit buttons identified.
  $form['#process'][] = 'drupaljira_board_task_form_actions';
  $form['#validate'][] = 'drupaljira_board_task_form_validate';
}

/**
 * Preserves the original submit action and adds a state-preserving save action.
 */
function drupaljira_board_task_form_actions(
  array $form,
  FormStateInterface $form_state,
): array {
  $form['actions']['save_without_transition'] = $form['actions']['submit'];
  $form['actions']['save_without_transition']['#value'] = t('Save');
  $form['actions']['save_without_transition']['#name'] = 'save_without_transition';
  $form['actions']['save_without_transition']['#weight'] = -5;

  $validation_sections = [];
  foreach ($form as $key => $element) {
    if (str_starts_with($key, '#') || $key === 'moderation_state' || $key === 'actions') {
      continue;
    }
    $validation_sections[] = [$key];
  }
  // There is no self-transition in this workflow. Normal Save validates all
  // edited fields except the moderation transition it does not perform.
  $form['actions']['save_without_transition']['#limit_validation_errors'] = $validation_sections;

  $form['actions']['#id'] = 'drupaljira-task-actions';
  $form['moderation_state']['widget'][0]['state']['#ajax'] = [
    'callback' => 'drupaljira_board_task_actions_ajax',
    'wrapper' => 'drupaljira-task-actions',
  ];
  return drupaljira_board_task_transition_label($form, $form_state);
}

/**
 * Labels Drupal's original submit action with the target state.
 */
function drupaljira_board_task_transition_label(
  array $form,
  FormStateInterface $form_state,
): array {
  $state = $form['moderation_state']['widget'][0]['state'];
  // The current state may not be a transition target. In that case Drupal's
  // select renders with the browser selecting its first allowed option.
  $options = $state['#options'];
  $input = $form_state->getUserInput();
  $value = $input['moderation_state'][0]['state'] ?? $state['#default_value'];
  $label = is_string($value) && isset($options[$value])
    ? $options[$value] : ($options ? reset($options) : NULL);
  $form['actions']['submit']['#access'] = ($form['actions']['submit']['#access'] ?? TRUE)
    && ($state['#access'] ?? TRUE) && $label !== NULL;
  if ($label !== NULL) {
    $form['actions']['submit']['#value'] = t('Save as @state', ['@state' => $label]);
  }
  return $form;
}

/**
 * Refreshes the action label when the moderation widget selection changes.
 */
function drupaljira_board_task_actions_ajax(
  array &$form,
  FormStateInterface $form_state,
): array {
  return $form['actions'];
}

/**
 * Prevents the normal Save button from changing the moderation state.
 */
function drupaljira_board_task_form_validate(
  array &$form,
  FormStateInterface $form_state,
): void {
  $triggering_element = $form_state->getTriggeringElement();

  if (
    ($triggering_element['#name'] ?? '') !== 'save_without_transition'
  ) {
    return;
  }

  $form_state->unsetValue('moderation_state');
}
