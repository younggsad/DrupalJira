<?php

/**
 * @file
 * Primary module hooks for DrupalJira TimeLog module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\drupaljira_timelog\TimeLogInterface;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_theme().
 */
function drupaljira_timelog_theme(): array {
  return [
    'time_log' => ['render element' => 'elements'],
    'drupaljira_project_stats' => [
      'variables' => [
        'project' => NULL,
        'project_name' => '',
        'total_estimate' => '',
        'total_logged' => '',
        'remaining_hours' => '',
        'tasks_summary' => '',
        'over_estimate_count' => '',
      ],
    ],
  ];
}

/**
 * Invalidates project statistics cache for a time log.
 *
 * @param \Drupal\drupaljira_timelog\TimeLogInterface $time_log
 *   The time log entity.
 */
function _drupaljira_timelog_invalidate_project_stats_cache(
  TimeLogInterface $time_log,
): void {
  $task = $time_log->get('task')->entity;

  if (!$task instanceof NodeInterface) {
    return;
  }

  $project = $task->get('field_project')->entity;

  if (!$project instanceof NodeInterface) {
    return;
  }

  Cache::invalidateTags([
    'drupaljira_project_stats:' . $project->id(),
  ]);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for time_log entities.
 */
function drupaljira_timelog_time_log_insert(TimeLogInterface $entity): void {
  _drupaljira_timelog_invalidate_project_stats_cache($entity);

  $task = $entity->get('task')->entity;
  $user = $entity->getOwner();

  \Drupal::logger('drupaljira_timelog')->notice(
    'Time logged: user @user (@uid), @hours hours, task @task.',
    [
      '@user' => $user ? $user->getDisplayName() : 'Unknown',
      '@uid' => $entity->getOwnerId(),
      '@hours' => $entity->get('hours')->value,
      '@task' => $task instanceof NodeInterface
        ? $task->id()
        : 'Unknown',
    ]
  );
}

/**
 * Implements hook_ENTITY_TYPE_update() for time_log entities.
 */
function drupaljira_timelog_time_log_update(TimeLogInterface $entity): void {
  _drupaljira_timelog_invalidate_project_stats_cache($entity);

  if (
    isset($entity->original)
    && $entity->original instanceof TimeLogInterface
  ) {
    _drupaljira_timelog_invalidate_project_stats_cache($entity->original);
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete() for time_log entities.
 */
function drupaljira_timelog_time_log_delete(TimeLogInterface $entity): void {
  _drupaljira_timelog_invalidate_project_stats_cache($entity);
}

/**
 * Prepares variables for time log templates.
 *
 * Default template: time-log.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the time log information
 *     and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_time_log(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];

  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_user_cancel().
 */
function drupaljira_timelog_user_cancel(
  $edit,
  UserInterface $account,
  $method,
): void {
  switch ($method) {
    case 'user_cancel_reassign':
      // Anonymize time logs.
      $storage = \Drupal::entityTypeManager()->getStorage('time_log');

      $time_log_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();

      /** @var \Drupal\drupaljira_timelog\TimeLogInterface[] $time_logs */
      $time_logs = $storage->loadMultiple($time_log_ids);

      foreach ($time_logs as $time_log) {
        $time_log->setOwnerId(0);
        $time_log->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function drupaljira_timelog_user_predelete(
  UserInterface $account,
): void {
  // Delete time logs that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('time_log');

  $time_log_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();

  $storage->delete(
    $storage->loadMultiple($time_log_ids)
  );
}

/**
 * Implements hook_form_alter().
 */
function drupaljira_timelog_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id,
): void {
  $form_object = $form_state->getFormObject();

  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $node = $form_object->getEntity();

  if (!$node instanceof NodeInterface) {
    return;
  }

  if ($node->bundle() !== 'task' || $node->isNew()) {
    return;
  }

  $url = Url::fromRoute(
    'drupaljira_timelog.write_off',
    ['task' => $node->id()]
  );

  $form['write_off_time'] = [
    '#type' => 'link',
    '#title' => t('Write off time'),
    '#url' => $url,
    '#attributes' => [
      'class' => ['button'],
    ],
  ];
}
