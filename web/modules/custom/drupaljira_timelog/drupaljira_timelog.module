<?php

/**
 * @file
 * Primary module hooks for DrupalJira TimeLog module.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_theme().
 */
function drupaljira_timelog_theme(): array {
  return [
    'time_log' => ['render element' => 'elements'],
    'drupaljira_project_stats' => [
      'variables' => [
        'project' => NULL,
        'project_name' => '',
        'total_estimate' => '',
        'total_logged' => '',
        'remaining_hours' => '',
        'tasks_summary' => '',
        'over_estimate_count' => '',
      ],
    ],
  ];
}

/**
 * Prepares variables for the project statistics template.
 *
 * @param array $variables
 *   An associative array containing project statistics variables.
 */
function drupaljira_timelog_preprocess_drupaljira_project_stats(
  array &$variables,
): void {
  $project = $variables['project'];

  if (!$project instanceof NodeInterface) {
    return;
  }

  /** @var \Drupal\drupaljira_timelog\Service\TaskStatService $task_stat_service */
  $task_stat_service = \Drupal::service('drupaljira.task_stat');

  $stats = $task_stat_service->getProjectStats($project);

  $total_estimate = (float) $stats['total_estimate'];
  $total_logged = (float) $stats['total_logged'];
  $remaining_hours = (float) $stats['remaining_hours'];

  $variables['project_name'] = $project->label();

  $variables['total_estimate'] = t('Total pledged: @hours hours', [
    '@hours' => _drupaljira_timelog_format_hours($total_estimate),
  ]);

  $variables['total_logged'] = t('Total logged: @hours hours', [
    '@hours' => _drupaljira_timelog_format_hours($total_logged),
  ]);

  $variables['remaining_hours'] = t('Remaining: @hours hours', [
    '@hours' => _drupaljira_timelog_format_hours($remaining_hours),
  ]);

  $variables['tasks_summary'] = t('Completed tasks: @done of @total', [
    '@done' => $stats['done_count'],
    '@total' => $stats['task_count'],
  ]);

  $variables['over_estimate_count'] = t(
    'Tasks over estimate: @count',
    [
      '@count' => $stats['over_estimate_count'],
    ],
  );
}

/**
 * Formats a number of hours for display.
 *
 * @param float $hours
 *   The number of hours.
 *
 * @return string
 *   The formatted number.
 */
function _drupaljira_timelog_format_hours(float $hours): string {
  return rtrim(
    rtrim(number_format($hours, 2, '.', ''), '0'),
    '.',
  );
}

/**
 * Prepares variables for time log templates.
 *
 * Default template: time-log.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the time log information
 *     and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_time_log(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];

  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_user_cancel().
 */
function drupaljira_timelog_user_cancel(
  $edit,
  UserInterface $account,
  $method,
): void {
  switch ($method) {
    case 'user_cancel_reassign':
      // Anonymize time logs.
      $storage = \Drupal::entityTypeManager()->getStorage('time_log');

      $time_log_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();

      /** @var \Drupal\drupaljira_timelog\TimeLogInterface[] $time_logs */
      $time_logs = $storage->loadMultiple($time_log_ids);

      foreach ($time_logs as $time_log) {
        $time_log->setOwnerId(0);
        $time_log->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function drupaljira_timelog_user_predelete(
  UserInterface $account,
): void {
  // Delete time logs that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('time_log');

  $time_log_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();

  $storage->delete(
    $storage->loadMultiple($time_log_ids)
  );
}

/**
 * Implements hook_form_alter().
 */
function drupaljira_timelog_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id,
): void {
  $form_object = $form_state->getFormObject();

  if (!method_exists($form_object, 'getEntity')) {
    return;
  }

  $node = $form_object->getEntity();

  if (!$node instanceof NodeInterface) {
    return;
  }

  if ($node->bundle() !== 'task' || $node->isNew()) {
    return;
  }

  $url = Url::fromRoute(
    'drupaljira_timelog.write_off',
    ['task' => $node->id()]
  );

  $form['write_off_time'] = [
    '#type' => 'link',
    '#title' => t('Write off time'),
    '#url' => $url,
    '#attributes' => [
      'class' => ['button'],
    ],
  ];
}
